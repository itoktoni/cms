---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import homeData from '../content/pages/home.json';

const services = await getCollection('services');
services.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const { slider, stats, why_us, cta } = homeData.sections;
---

<BaseLayout title={homeData.title}>
  <!-- Slider / Hero -->
  {slider.enabled && (
    <section class="relative overflow-hidden">
      <div id="hero-slider" class="relative">
        {slider.items.map((slide, i) => (
          <div
            class={`hero-slide ${i === 0 ? '' : 'hidden'} transition-opacity duration-700`}
            style={slide.image ? `background-image: url('${slide.image}'); background-size: cover; background-position: center;` : ''}
          >
            <div class={`py-20 md:py-32 ${slide.image ? 'bg-primary/80' : 'bg-gradient-to-br from-primary via-primary-light to-secondary'}`}>
              <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 leading-tight">{slide.title}</h1>
                <p class="text-lg md:text-xl text-blue-100 max-w-3xl mx-auto mb-10">{slide.subtitle}</p>
                {slide.button_text && (
                  <a href={slide.button_url || '/kontak'} class="inline-flex items-center px-8 py-4 bg-secondary hover:bg-sky-600 text-white font-semibold rounded-xl text-lg transition-all shadow-xl hover:shadow-2xl">
                    {slide.button_text}
                    <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
      {slider.items.length > 1 && (
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2 z-10">
          {slider.items.map((_, i) => (
            <button class={`slider-dot w-3 h-3 rounded-full transition-colors ${i === 0 ? 'bg-white' : 'bg-white/40'}`} data-index={i} aria-label={`Slide ${i + 1}`}></button>
          ))}
        </div>
      )}
    </section>
  )}

  <!-- Stats -->
  {stats.enabled && (
    <section class="py-12 bg-white border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
          {stats.items.map(stat => (
            <div>
              <div class="text-3xl md:text-4xl font-extrabold text-primary">{stat.value}</div>
              <div class="text-sm text-gray-500 mt-1">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Services from collection -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="text-secondary font-semibold text-sm uppercase tracking-wider">Layanan Kami</span>
        <h2 class="text-3xl md:text-4xl font-bold text-primary mt-2">Solusi Lengkap Alat Kesehatan</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map(service => (
          <a href={`/layanan/${service.id}`} class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-secondary/30">
            {service.data.image && (
              <img src={service.data.image} alt={service.data.title} class="w-full h-40 object-cover rounded-xl mb-5" />
            )}
            <div class="w-14 h-14 bg-secondary/10 rounded-xl flex items-center justify-center mb-5 group-hover:bg-secondary/20 transition-colors">
              <span class="text-2xl">{service.data.icon}</span>
            </div>
            <h3 class="text-xl font-bold text-primary mb-3 group-hover:text-secondary transition-colors">{service.data.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{service.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Us -->
  {why_us.enabled && (
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="text-secondary font-semibold text-sm uppercase tracking-wider">Keunggulan</span>
          <h2 class="text-3xl md:text-4xl font-bold text-primary mt-2">{why_us.heading}</h2>
          {why_us.subheading && <p class="text-gray-600 mt-3 max-w-2xl mx-auto">{why_us.subheading}</p>}
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {why_us.items.map(item => (
            <div class="text-center p-6">
              <div class="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <span class="text-3xl">{item.icon}</span>
              </div>
              <h4 class="text-lg font-bold text-primary mb-2">{item.title}</h4>
              <p class="text-gray-600 text-sm">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  {cta.enabled && (
    <section class="py-16 md:py-24 bg-gradient-to-br from-primary to-primary-light">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-4">{cta.heading}</h2>
        <p class="text-lg text-blue-100 mb-8">{cta.description}</p>
        <a href={cta.button_url || '/kontak'} class="inline-flex items-center px-8 py-4 bg-secondary hover:bg-sky-600 text-white font-semibold rounded-xl text-lg transition-all shadow-xl">
          {cta.button_text}
        </a>
      </div>
    </section>
  )}

  <!-- Slider Script -->
  <script>
    const slides = document.querySelectorAll('.hero-slide');
    const dots = document.querySelectorAll('.slider-dot');
    if (slides.length > 1) {
      let current = 0;
      function showSlide(n: number) {
        slides.forEach((s, i) => {
          (s as HTMLElement).classList.toggle('hidden', i !== n);
        });
        dots.forEach((d, i) => {
          (d as HTMLElement).classList.toggle('bg-white', i === n);
          (d as HTMLElement).classList.toggle('bg-white/40', i !== n);
        });
        current = n;
      }
      dots.forEach(dot => {
        dot.addEventListener('click', () => {
          showSlide(Number((dot as HTMLElement).dataset.index));
        });
      });
      setInterval(() => showSlide((current + 1) % slides.length), 5000);
    }
  </script>
</BaseLayout>