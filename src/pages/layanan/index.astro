---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services');
services.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout title="Layanan">
  <section class="bg-gradient-to-br from-primary to-primary-light py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">Layanan Kami</h1>
      <p class="text-lg text-blue-100 max-w-2xl mx-auto">Solusi lengkap maintenance, kalibrasi, dan perbaikan alat kesehatan untuk rumah sakit dan klinik.</p>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map(service => (
          <a href={`/layanan/${service.id}`} class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-secondary/30">
            <div class="w-14 h-14 bg-secondary/10 rounded-xl flex items-center justify-center mb-5 group-hover:bg-secondary/20 transition-colors">
              <span class="text-2xl">{service.data.icon}</span>
            </div>
            <h2 class="text-xl font-bold text-primary mb-3 group-hover:text-secondary transition-colors">{service.data.title}</h2>
            <p class="text-gray-600 text-sm leading-relaxed">{service.data.description}</p>
            <div class="mt-5 flex items-center text-secondary font-medium text-sm">
              Selengkapnya →
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>