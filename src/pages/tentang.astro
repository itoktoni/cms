---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Tentang Kami">
  <section class="bg-gradient-to-br from-primary to-primary-light py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">Tentang MedTech Kalibra</h1>
      <p class="text-lg text-blue-100 max-w-2xl mx-auto">Lebih dari 15 tahun mengabdi untuk keselamatan pasien melalui akurasi alat kesehatan.</p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <span class="text-secondary font-semibold text-sm uppercase tracking-wider">Sejarah Kami</span>
          <h2 class="text-3xl font-bold text-primary mt-2 mb-6">Berdiri Sejak 2010</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            MedTech Kalibra didirikan dengan visi menjadi mitra terpercaya bagi fasilitas kesehatan di Indonesia 
            dalam menjaga akurasi dan keandalan peralatan medis. Bermula dari tim kecil yang terdiri dari 
            para insinyur biomedis berpengalaman, kini kami telah berkembang menjadi perusahaan dengan lebih 
            dari 50 teknisi tersertifikasi.
          </p>
          <p class="text-gray-600 leading-relaxed mb-4">
            Kami memahami bahwa setiap angka yang ditampilkan oleh alat kesehatan memiliki dampak langsung 
            terhadap keputusan medis. Oleh karena itu, kami berkomitmen untuk memastikan setiap alat yang 
            kami tangani memenuhi standar akurasi tertinggi.
          </p>
          <p class="text-gray-600 leading-relaxed">
            Dengan laboratorium kalibrasi terakreditasi KAN dan tim yang terus mengikuti perkembangan 
            teknologi terbaru, kami siap melayani kebutuhan maintenance dan kalibrasi alat kesehatan 
            di seluruh Indonesia.
          </p>
        </div>
        <div class="bg-gradient-to-br from-blue-50 to-emerald-50 rounded-3xl p-8 md:p-12">
          <div class="space-y-6">
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 bg-primary rounded-2xl flex items-center justify-center text-white font-bold text-xl shrink-0">2010</div>
              <div>
                <h4 class="font-semibold text-primary">Pendirian Perusahaan</h4>
                <p class="text-sm text-gray-600">Dimulai dengan 5 teknisi di Jakarta</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 bg-primary-light rounded-2xl flex items-center justify-center text-white font-bold text-xl shrink-0">2014</div>
              <div>
                <h4 class="font-semibold text-primary">Akreditasi KAN</h4>
                <p class="text-sm text-gray-600">Laboratorium kalibrasi terakreditasi</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 bg-secondary rounded-2xl flex items-center justify-center text-white font-bold text-xl shrink-0">2018</div>
              <div>
                <h4 class="font-semibold text-primary">Ekspansi Nasional</h4>
                <p class="text-sm text-gray-600">Cabang di 5 kota besar Indonesia</p>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <div class="w-16 h-16 bg-accent rounded-2xl flex items-center justify-center text-white font-bold text-xl shrink-0">2026</div>
              <div>
                <h4 class="font-semibold text-primary">500+ Klien Aktif</h4>
                <p class="text-sm text-gray-600">Melayani RS dan klinik seluruh Indonesia</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Visi Misi -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white rounded-2xl p-8 md:p-10 shadow-sm border border-gray-100">
          <div class="w-14 h-14 bg-secondary/10 rounded-xl flex items-center justify-center mb-5">
            <span class="text-2xl">🔭</span>
          </div>
          <h3 class="text-2xl font-bold text-primary mb-4">Visi</h3>
          <p class="text-gray-600 leading-relaxed">
            Menjadi perusahaan terdepan di Indonesia dalam penyediaan jasa maintenance dan kalibrasi 
            alat kesehatan yang berkualitas, akurat, dan terpercaya demi mendukung peningkatan mutu 
            pelayanan kesehatan nasional.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-8 md:p-10 shadow-sm border border-gray-100">
          <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center mb-5">
            <span class="text-2xl">🎯</span>
          </div>
          <h3 class="text-2xl font-bold text-primary mb-4">Misi</h3>
          <ul class="text-gray-600 space-y-3">
            <li class="flex gap-2"><span class="text-accent">✓</span> Menyediakan layanan kalibrasi sesuai standar nasional dan internasional</li>
            <li class="flex gap-2"><span class="text-accent">✓</span> Mengembangkan SDM yang kompeten dan profesional</li>
            <li class="flex gap-2"><span class="text-accent">✓</span> Memberikan respons cepat dan solusi tepat bagi klien</li>
            <li class="flex gap-2"><span class="text-accent">✓</span> Berkontribusi pada keselamatan pasien melalui akurasi alat</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Sertifikasi -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-secondary font-semibold text-sm uppercase tracking-wider">Sertifikasi & Akreditasi</span>
      <h2 class="text-3xl font-bold text-primary mt-2 mb-12">Dipercaya Karena Terstandarisasi</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="p-6 bg-gray-50 rounded-2xl">
          <div class="text-3xl mb-3">🏅</div>
          <h4 class="font-semibold text-primary">KAN</h4>
          <p class="text-xs text-gray-500 mt-1">Komite Akreditasi Nasional</p>
        </div>
        <div class="p-6 bg-gray-50 rounded-2xl">
          <div class="text-3xl mb-3">📜</div>
          <h4 class="font-semibold text-primary">ISO 17025</h4>
          <p class="text-xs text-gray-500 mt-1">Laboratorium Pengujian</p>
        </div>
        <div class="p-6 bg-gray-50 rounded-2xl">
          <div class="text-3xl mb-3">📋</div>
          <h4 class="font-semibold text-primary">ISO 9001</h4>
          <p class="text-xs text-gray-500 mt-1">Manajemen Mutu</p>
        </div>
        <div class="p-6 bg-gray-50 rounded-2xl">
          <div class="text-3xl mb-3">🏥</div>
          <h4 class="font-semibold text-primary">Kemenkes RI</h4>
          <p class="text-xs text-gray-500 mt-1">Izin Resmi</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>