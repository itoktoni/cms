---
import BaseLayout from '../layouts/BaseLayout.astro';
import aboutData from '../content/pages/about.json';

const { hero, history, vision_mission, certifications } = aboutData.sections;
---

<BaseLayout title={aboutData.title}>
  <!-- Hero -->
  {hero.enabled && (
    <section class="bg-gradient-to-br from-primary to-primary-light py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">{hero.heading}</h1>
        <p class="text-lg text-blue-100 max-w-2xl mx-auto">{hero.subheading}</p>
      </div>
    </section>
  )}

  <!-- History -->
  {history.enabled && (
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-16 items-center">
          <div>
            <span class="text-secondary font-semibold text-sm uppercase tracking-wider">Sejarah Kami</span>
            <h2 class="text-3xl font-bold text-primary mt-2 mb-6">{history.heading}</h2>
            <p class="text-gray-600 leading-relaxed">{history.description}</p>
          </div>
          <div class="bg-gradient-to-br from-blue-50 to-emerald-50 rounded-3xl p-8 md:p-12">
            <div class="space-y-6">
              {history.milestones.map((m, i) => {
                const colors = ['bg-primary', 'bg-primary-light', 'bg-secondary', 'bg-accent'];
                return (
                  <div class="flex items-center gap-4">
                    <div class={`w-16 h-16 ${colors[i % colors.length]} rounded-2xl flex items-center justify-center text-white font-bold text-xl shrink-0`}>{m.year}</div>
                    <div>
                      <h4 class="font-semibold text-primary">{m.title}</h4>
                      <p class="text-sm text-gray-600">{m.description}</p>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Visi Misi -->
  {vision_mission.enabled && (
    <section class="py-16 md:py-24 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white rounded-2xl p-8 md:p-10 shadow-sm border border-gray-100">
            <div class="w-14 h-14 bg-secondary/10 rounded-xl flex items-center justify-center mb-5">
              <span class="text-2xl">🔭</span>
            </div>
            <h3 class="text-2xl font-bold text-primary mb-4">Visi</h3>
            <p class="text-gray-600 leading-relaxed">{vision_mission.vision}</p>
          </div>
          <div class="bg-white rounded-2xl p-8 md:p-10 shadow-sm border border-gray-100">
            <div class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center mb-5">
              <span class="text-2xl">🎯</span>
            </div>
            <h3 class="text-2xl font-bold text-primary mb-4">Misi</h3>
            <ul class="text-gray-600 space-y-3">
              {vision_mission.missions.map(m => (
                <li class="flex gap-2"><span class="text-accent">✓</span> {m}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Sertifikasi -->
  {certifications.enabled && (
    <section class="py-16 md:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="text-secondary font-semibold text-sm uppercase tracking-wider">Sertifikasi & Akreditasi</span>
        <h2 class="text-3xl font-bold text-primary mt-2 mb-12">{certifications.heading}</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {certifications.items.map(cert => (
            <div class="p-6 bg-gray-50 rounded-2xl">
              <div class="text-3xl mb-3">{cert.icon}</div>
              <h4 class="font-semibold text-primary">{cert.title}</h4>
              <p class="text-xs text-gray-500 mt-1">{cert.subtitle}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>