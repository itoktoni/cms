---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Hubungi Kami">
  <section class="bg-gradient-to-br from-primary to-primary-light py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">Hubungi Kami</h1>
      <p class="text-lg text-blue-100 max-w-2xl mx-auto">Konsultasikan kebutuhan maintenance dan kalibrasi alat kesehatan Anda. Tim kami siap membantu.</p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12">
        <!-- Contact Form -->
        <div>
          <h2 class="text-2xl font-bold text-primary mb-6">Kirim Pesan</h2>
          <form class="space-y-5" action="#" method="POST">
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="nama" class="block text-sm font-medium text-gray-700 mb-1">Nama Lengkap</label>
                <input type="text" id="nama" name="nama" required class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-secondary focus:border-secondary outline-none transition-colors" placeholder="Nama Anda" />
              </div>
              <div>
                <label for="instansi" class="block text-sm font-medium text-gray-700 mb-1">Instansi / RS</label>
                <input type="text" id="instansi" name="instansi" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-secondary focus:border-secondary outline-none transition-colors" placeholder="Nama rumah sakit / klinik" />
              </div>
            </div>
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-secondary focus:border-secondary outline-none transition-colors" placeholder="email@contoh.com" />
              </div>
              <div>
                <label for="telepon" class="block text-sm font-medium text-gray-700 mb-1">No. Telepon / WhatsApp</label>
                <input type="tel" id="telepon" name="telepon" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-secondary focus:border-secondary outline-none transition-colors" placeholder="08xx-xxxx-xxxx" />
              </div>
            </div>
            <div>
              <label for="layanan" class="block text-sm font-medium text-gray-700 mb-1">Layanan yang Dibutuhkan</label>
              <select id="layanan" name="layanan" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-secondary focus:border-secondary outline-none transition-colors bg-white">
                <option value="">Pilih layanan...</option>
                <option value="kalibrasi">Kalibrasi Alat Kesehatan</option>
                <option value="maintenance">Preventive Maintenance</option>
                <option value="perbaikan">Perbaikan / Corrective Maintenance</option>
                <option value="instalasi">Instalasi & Komisioning</option>
                <option value="konsultasi">Konsultasi & Pelatihan</option>
                <option value="uji-keselamatan">Uji Keselamatan Listrik</option>
                <option value="lainnya">Lainnya</option>
              </select>
            </div>
            <div>
              <label for="pesan" class="block text-sm font-medium text-gray-700 mb-1">Pesan</label>
              <textarea id="pesan" name="pesan" rows="5" required class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-secondary focus:border-secondary outline-none transition-colors resize-none" placeholder="Jelaskan kebutuhan Anda..."></textarea>
            </div>
            <button type="submit" class="w-full sm:w-auto px-8 py-3.5 bg-secondary hover:bg-sky-600 text-white font-semibold rounded-xl transition-colors shadow-lg">
              Kirim Pesan
            </button>
          </form>
        </div>

        <!-- Contact Info -->
        <div>
          <h2 class="text-2xl font-bold text-primary mb-6">Informasi Kontak</h2>
          <div class="space-y-6">
            <div class="flex gap-4 p-5 bg-gray-50 rounded-xl">
              <div class="w-12 h-12 bg-secondary/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <h4 class="font-semibold text-primary">Alamat Kantor</h4>
                <p class="text-sm text-gray-600 mt-1">Jl. Kesehatan No. 123<br/>Jakarta Selatan 12345, Indonesia</p>
              </div>
            </div>
            <div class="flex gap-4 p-5 bg-gray-50 rounded-xl">
              <div class="w-12 h-12 bg-secondary/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <h4 class="font-semibold text-primary">Telepon</h4>
                <p class="text-sm text-gray-600 mt-1">(021) 1234-5678</p>
                <p class="text-sm text-gray-600">0812-3456-7890 (WhatsApp)</p>
              </div>
            </div>
            <div class="flex gap-4 p-5 bg-gray-50 rounded-xl">
              <div class="w-12 h-12 bg-secondary/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h4 class="font-semibold text-primary">Email</h4>
                <p class="text-sm text-gray-600 mt-1">info@medtechkalibra.co.id</p>
                <p class="text-sm text-gray-600">sales@medtechkalibra.co.id</p>
              </div>
            </div>
            <div class="flex gap-4 p-5 bg-gray-50 rounded-xl">
              <div class="w-12 h-12 bg-secondary/10 rounded-xl flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h4 class="font-semibold text-primary">Jam Operasional</h4>
                <p class="text-sm text-gray-600 mt-1">Senin - Jumat: 08.00 - 17.00 WIB</p>
                <p class="text-sm text-gray-600">Sabtu: 08.00 - 12.00 WIB</p>
                <p class="text-sm text-gray-500 text-xs mt-1">* Layanan darurat 24 jam tersedia</p>
              </div>
            </div>
          </div>

          <!-- WhatsApp CTA -->
          <a href="https://wa.me/6281234567890" target="_blank" rel="noopener" class="mt-6 flex items-center justify-center gap-2 w-full px-6 py-4 bg-accent hover:bg-emerald-600 text-white font-semibold rounded-xl transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Chat WhatsApp Langsung
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>