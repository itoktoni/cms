---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map(product => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const allProducts = await getCollection('products');
const relatedProducts = allProducts
  .filter(p => p.data.section === product.data.section && p.id !== product.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title={product.data.title}>
  <!-- Breadcrumb -->
  <div class="bg-surface-container-low py-4 border-b border-outline-variant/30">
    <div class="max-w-7xl mx-auto px-8">
      <nav class="flex items-center gap-2 text-sm text-on-surface-variant">
        <a href="/" class="hover:text-primary transition-colors">Beranda</a>
        <span class="material-symbols-outlined text-sm">chevron_right</span>
        <a href="/produk" class="hover:text-primary transition-colors">Produk</a>
        <span class="material-symbols-outlined text-sm">chevron_right</span>
        <span class="text-on-surface">{product.data.title}</span>
      </nav>
    </div>
  </div>

  <!-- Product Detail -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Image -->
        <div class="bg-surface-container-low rounded-2xl overflow-hidden aspect-square flex items-center justify-center">
          {product.data.image ? (
            <img src={product.data.image} alt={product.data.title} class="w-full h-full object-cover" />
          ) : (
            <span class="material-symbols-outlined text-8xl text-outline-variant">inventory_2</span>
          )}
        </div>

        <!-- Info -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-primary-container/10 text-primary text-xs font-bold px-3 py-1 rounded-full">{product.data.category}</span>
            <span class="bg-surface-container-high text-on-surface-variant text-xs px-3 py-1 rounded-full">{product.data.section}</span>
          </div>
          
          <h1 class="font-headline-xl text-headline-xl text-on-surface mb-4">{product.data.title}</h1>
          <p class="text-on-surface-variant text-body-lg mb-8">{product.data.description}</p>

          {product.data.price && (
            <div class="bg-surface-container-low rounded-xl p-6 mb-8">
              <span class="text-on-surface-variant text-sm">Harga</span>
              <div class="text-primary font-headline-lg text-headline-lg">{product.data.price}</div>
            </div>
          )}

          <!-- Specs -->
          {product.data.specs && product.data.specs.length > 0 && (
            <div class="mb-8">
              <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Spesifikasi</h3>
              <div class="grid grid-cols-2 gap-4">
                {product.data.specs.map(spec => (
                  <div class="bg-surface-container-low rounded-lg p-4">
                    <div class="text-on-surface-variant text-xs mb-1">{spec.label}</div>
                    <div class="text-on-surface font-medium text-sm">{spec.value}</div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Features -->
          {product.data.features && product.data.features.length > 0 && (
            <div class="mb-8">
              <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Fitur Utama</h3>
              <ul class="space-y-3">
                {product.data.features.map(feature => (
                  <li class="flex items-center gap-3 text-on-surface-variant">
                    <span class="material-symbols-outlined text-primary text-xl">check_circle</span>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <a href="/kontak" class="inline-flex items-center gap-2 bg-primary text-on-primary px-8 py-4 rounded-xl font-headline-md hover:shadow-lg transition-all">
            Hubungi Kami <span class="material-symbols-outlined">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Content (Markdown) -->
  <section class="py-16 bg-surface-container-low">
    <div class="max-w-4xl mx-auto px-8">
      <div class="bg-white rounded-2xl p-8 md:p-12 prose prose-lg max-w-none">
        <Content />
      </div>
    </div>
  </section>

  <!-- Related Products -->
  {relatedProducts.length > 0 && (
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-8">
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-8">Produk Lainnya</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {relatedProducts.map(related => (
            <a href={`/produk/${related.id}`} class="bg-surface-container-low rounded-xl overflow-hidden border border-outline-variant/30 hover:shadow-xl transition-all group block">
              <div class="h-40 emerald-gradient relative overflow-hidden flex items-center justify-center">
                <span class="material-symbols-outlined text-5xl text-white/20">inventory_2</span>
              </div>
              <div class="p-6">
                <h3 class="font-headline-md text-headline-md mb-2 group-hover:text-primary transition-colors">{related.data.title}</h3>
                <p class="text-on-surface-variant text-sm line-clamp-2">{related.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
