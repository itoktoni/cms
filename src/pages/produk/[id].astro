---
import BaseLayout from '../../layouts/BaseLayout.astro';
import productsData from '../../content/pages/products.json';

export async function getStaticPaths() {
  const allProducts = [];
  
  for (const section of productsData.sections) {
    if (!section.enabled || !section.products) continue;
    for (const product of section.products) {
      allProducts.push({
        params: { id: product.slug },
        props: { 
          product,
          section
        },
      });
    }
  }
  
  return allProducts;
}

const { product, section } = Astro.props;

// Get related products (same section, excluding current)
const relatedProducts = (section.products || [])
  .filter(p => p.slug !== product.slug)
  .sort((a, b) => a.order - b.order)
  .slice(0, 3);

// Convert markdown-like content to HTML (simple implementation)
function renderContent(content: string) {
  if (!content) return '';
  return content
    .replace(/^## (.+)$/gm, '<h2>$1</h2>')
    .replace(/^### (.+)$/gm, '<h3>$1</h3>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/^- (.+)$/gm, '<li>$1</li>')
    .replace(/(<li>.*<\/li>\n?)+/gs, (match) => `<ul>${match}</ul>`)
    .replace(/\n\n/g, '</p><p>')
    .replace(/^(?!<[hlu])(.+)$/gm, '<p>$1</p>');
}
---

<BaseLayout title={product.title}>
  <!-- Breadcrumb -->
  <div class="bg-surface-container-low py-4 border-b border-outline-variant/30">
    <div class="max-w-7xl mx-auto px-8">
      <nav class="flex items-center gap-2 text-sm text-on-surface-variant">
        <a href="/" class="hover:text-primary transition-colors">Beranda</a>
        <span class="material-symbols-outlined text-sm">chevron_right</span>
        <a href="/produk" class="hover:text-primary transition-colors">Produk</a>
        <span class="material-symbols-outlined text-sm">chevron_right</span>
        <span class="text-on-surface">{product.title}</span>
      </nav>
    </div>
  </div>

  <!-- Product Detail -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Image -->
        <div class="bg-surface-container-low rounded-2xl overflow-hidden aspect-square flex items-center justify-center">
          {product.image ? (
            <img src={product.image} alt={product.title} class="w-full h-full object-cover" />
          ) : (
            <span class="material-symbols-outlined text-8xl text-outline-variant">inventory_2</span>
          )}
        </div>

        <!-- Info -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="bg-primary-container/10 text-primary text-xs font-bold px-3 py-1 rounded-full">{product.category}</span>
            <span class="bg-surface-container-high text-on-surface-variant text-xs px-3 py-1 rounded-full">{section.heading}</span>
          </div>
          
          <h1 class="font-headline-xl text-headline-xl text-on-surface mb-4">{product.title}</h1>
          <p class="text-on-surface-variant text-body-lg mb-8">{product.description}</p>

          {product.price && (
            <div class="bg-surface-container-low rounded-xl p-6 mb-8">
              <span class="text-on-surface-variant text-sm">Harga</span>
              <div class="text-primary font-headline-lg text-headline-lg">{product.price}</div>
            </div>
          )}

          <!-- Specs -->
          {product.specs && product.specs.length > 0 && (
            <div class="mb-8">
              <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Spesifikasi</h3>
              <div class="grid grid-cols-2 gap-4">
                {product.specs.map(spec => (
                  <div class="bg-surface-container-low rounded-lg p-4">
                    <div class="text-on-surface-variant text-xs mb-1">{spec.label}</div>
                    <div class="text-on-surface font-medium text-sm">{spec.value}</div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Features -->
          {product.features && product.features.length > 0 && (
            <div class="mb-8">
              <h3 class="font-headline-md text-headline-md text-on-surface mb-4">Fitur Utama</h3>
              <ul class="space-y-3">
                {product.features.map(feature => (
                  <li class="flex items-center gap-3 text-on-surface-variant">
                    <span class="material-symbols-outlined text-primary text-xl">check_circle</span>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <a href="/kontak" class="inline-flex items-center gap-2 bg-primary text-on-primary px-8 py-4 rounded-xl font-headline-md hover:shadow-lg transition-all">
            Hubungi Kami <span class="material-symbols-outlined">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Content -->
  {product.content && (
    <section class="py-16 bg-surface-container-low">
      <div class="max-w-4xl mx-auto px-8">
        <div class="bg-white rounded-2xl p-8 md:p-12 prose prose-lg max-w-none" set:html={renderContent(product.content)}>
        </div>
      </div>
    </section>
  )}

  <!-- Related Products -->
  {relatedProducts.length > 0 && (
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-8">
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-8">Produk Lainnya</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {relatedProducts.map(related => (
            <a href={`/produk/${related.slug}`} class="bg-surface-container-low rounded-xl overflow-hidden border border-outline-variant/30 hover:shadow-xl transition-all group block">
              <div class="h-40 emerald-gradient relative overflow-hidden flex items-center justify-center">
                <span class="material-symbols-outlined text-5xl text-white/20">inventory_2</span>
              </div>
              <div class="p-6">
                <h3 class="font-headline-md text-headline-md mb-2 group-hover:text-primary transition-colors">{related.title}</h3>
                <p class="text-on-surface-variant text-sm line-clamp-2">{related.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
