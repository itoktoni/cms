---
import '../styles/global.css';
import navigation from '../content/settings/navigation.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'ECM - PT. Elsyahfi Calibratech Mandiri, Institusi Pengujian Fasilitas Kesehatan (IPFK) di Sumatera Barat' } = Astro.props;
const navItems = navigation.items;
---

<!doctype html>
<html class="scroll-smooth" lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="ECM, PT. Elsyahfi Calibratech Mandiri, Kalibrasi alat kesehatan, IPFK, Sumatera Barat, Payakumbuh" />
    <meta name="author" content="ECM" />
    <meta property="og:title" content={`${title} | ECM`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://ecm.co.id/assets/img/ecm.png" />
    <meta property="og:url" content="https://ecm.co.id" />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@600;700;800&family=Hanken+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <title>{title} | ECM</title>
  </head>
  <body class="bg-background text-on-surface font-body-md selection:bg-secondary-container/30">
    <!-- TopNavBar -->
    <nav class="fixed top-0 w-full z-50 bg-surface/80 backdrop-blur-md border-b border-outline-variant/30 shadow-sm transition-all duration-300" id="main-nav">
      <div class="flex justify-between items-center px-8 py-4 max-w-7xl mx-auto">
        <div class="flex items-center gap-3">
          <img alt="ECM Logo" class="h-10 w-auto" src="https://ecm.co.id/assets/img/ecm.png" />
          <span class="font-headline-md text-headline-md font-bold text-primary hidden">ECM</span>
        </div>
        <div class="hidden md:flex items-center space-x-8">
          {navItems.map(item => (
            <a
              href={item.url}
              class={`font-label-md text-label-md ${item.highlight ? 'text-secondary border-b-2 border-secondary pb-1' : 'text-on-surface-variant'} hover:text-primary transition-colors duration-300`}
            >{item.label}</a>
          ))}
        </div>
        <div class="flex items-center gap-6">
          <button class="material-symbols-outlined text-on-surface-variant hover:text-primary transition-colors">search</button>
          <a href="/kontak" class="bg-primary text-on-primary px-6 py-2.5 rounded-lg font-label-md hover:opacity-90 active:scale-95 transition-all">Order Sekarang</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-[#007A4D] py-24 text-white">
      <div class="max-w-7xl mx-auto px-8 grid grid-cols-1 md:grid-cols-4 gap-gutter">
        <div class="md:col-span-1">
          <div class="flex items-center gap-3 mb-8">
            <img alt="ECM Logo" class="h-8 w-auto brightness-0 invert" src="https://ecm.co.id/assets/img/ecm.png" />
          </div>
          <p class="text-white/70 font-body-md mb-8">PT. Elsyahfi Calibratech Mandiri adalah Institusi Pengujian Fasilitas Kesehatan (IPFK) di Sumatera Barat yang berdiri sejak tahun 2018.</p>
          <div class="flex gap-4">
            <a href="https://www.instagram.com/ecm.elsyahfi/" target="_blank" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-secondary-container hover:text-on-secondary-container transition-all cursor-pointer">
              <span class="material-symbols-outlined text-xl">share</span>
            </a>
            <a href="mailto:ecm.pwk@gmail.com" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-secondary-container hover:text-on-secondary-container transition-all cursor-pointer">
              <span class="material-symbols-outlined text-xl">mail</span>
            </a>
            <a href="https://wa.me/6285263339098" target="_blank" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-secondary-container hover:text-on-secondary-container transition-all cursor-pointer">
              <span class="material-symbols-outlined text-xl">call</span>
            </a>
          </div>
        </div>
        <div>
          <h5 class="text-secondary-container font-headline-md mb-8">Layanan</h5>
          <ul class="space-y-4">
            <li><a class="text-white/70 font-label-md hover:text-white transition-colors" href="/layanan">Kalibrasi Alat Kesehatan</a></li>
            <li><a class="text-white/70 font-label-md hover:text-white transition-colors" href="/layanan">Inspeksi Preventive</a></li>
            <li><a class="text-white/70 font-label-md hover:text-white transition-colors" href="/layanan">Konsultasi Teknis</a></li>
            <li><a class="text-white/70 font-label-md hover:text-white transition-colors" href="/kontak">Verifikasi Sertifikat</a></li>
          </ul>
        </div>
        <div>
          <h5 class="text-secondary-container font-headline-md mb-8">Perusahaan</h5>
          <ul class="space-y-4">
            <li><a class="text-white/70 font-label-md hover:text-white transition-colors" href="/tentang">Tentang Kami</a></li>
            <li><a class="text-white/70 font-label-md hover:text-white transition-colors" href="/artikel">Berita</a></li>
            <li><a class="text-white/70 font-label-md hover:text-white transition-colors" href="/tentang">Sertifikat Akreditasi</a></li>
            <li><a class="text-white/70 font-label-md hover:text-white transition-colors" href="/kontak">Hubungi Kami</a></li>
          </ul>
        </div>
        <div>
          <h5 class="text-secondary-container font-headline-md mb-8">Kantor & Lab</h5>
          <ul class="space-y-4">
            <li><span class="text-white/70 font-label-md flex items-start gap-2">
              <span class="material-symbols-outlined text-sm mt-0.5">location_on</span>
              Jl. Perkutut Komp. Perumahan Nuansa Mandiri No B4, Payakumbuh - Sumatera Barat
            </span></li>
            <li><a class="text-white/70 font-label-md hover:text-white transition-colors" href="https://wa.me/6285263339098" target="_blank">+62 852 6333 9098</a></li>
            <li><a class="text-white/70 font-label-md hover:text-white transition-colors" href="mailto:ecm.pwk@gmail.com">ecm.pwk@gmail.com</a></li>
            <li><span class="text-white/70 font-label-md">IPFK Terakreditasi KAN</span></li>
          </ul>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-8 mt-24 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4">
        <span class="text-label-sm text-white/40">&copy; {new Date().getFullYear()} PT. Elsyahfi Calibratech Mandiri. All Rights Reserved.</span>
        <div class="flex gap-8 items-center">
          <span class="text-label-sm text-white/40 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span> Systems Operational
          </span>
          <span class="text-label-sm text-white/40">HQ: Payakumbuh, Sumatera Barat</span>
        </div>
      </div>
    </footer>

    <!-- Floating WhatsApp Button -->
    <a href="https://wa.me/6285263339098" target="_blank" class="fixed bottom-6 right-6 z-50 bg-[#25D366] text-white w-14 h-14 rounded-full flex items-center justify-center shadow-lg hover:scale-110 transition-transform" aria-label="Chat WhatsApp">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
    </a>

    <script>
      window.addEventListener('scroll', () => {
        const nav = document.getElementById('main-nav');
        if (!nav) return;
        if (window.scrollY > 50) {
          nav.classList.add('py-2', 'shadow-md');
          nav.classList.remove('py-4', 'shadow-sm');
        } else {
          nav.classList.add('py-4', 'shadow-sm');
          nav.classList.remove('py-2', 'shadow-md');
        }
      });
    </script>
  </body>
</html>